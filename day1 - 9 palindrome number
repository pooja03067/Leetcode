class Solution {
    public boolean isPalindrome(int x) {
        // Step 1: Handle edge cases
        // Negative numbers are not palindromes (e.g., -121 reversed is 121-)
        // Numbers ending in 0 are not palindromes (except 0 itself)
        if (x < 0 || (x % 10 == 0 && x != 0)) {
            return false;
        }

        int reversedNum = 0;
        
        // Step 2: Reverse only half of the integer to prevent overflow
        while (x > reversedNum) {
            reversedNum = reversedNum * 10 + (x % 10);
            x /= 10;
        }

        // Step 3: Check if original half matches the reversed half
        // For even-length digits: x == reversedNum
        // For odd-length digits: x == reversedNum / 10 (skips the middle digit)
        return x == reversedNum || x == reversedNum / 10;
    }
}
