class Solution {
    public boolean detectCapitalUse(String word) {
        int n = word.length();
        if (n == 1) {
            return true;
        }

        // Case 1: All letters are capitals or all are lowercase
        boolean allCaps = Character.isUpperCase(word.charAt(0)) && Character.isUpperCase(word.charAt(1));
        boolean allLower = Character.isLowerCase(word.charAt(0));

        for (int i = 2; i < n; i++) {
            if (allCaps && Character.isLowerCase(word.charAt(i))) {
                return false;
            }
            if (allLower && Character.isUpperCase(word.charAt(i))) {
                return false;
            }
            if (!allCaps && !allLower && Character.isUpperCase(word.charAt(i))) {
                return false;
            }
        }

        return true;
    }
}
